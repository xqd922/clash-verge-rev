{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/polyfills/*.js!"],
  "project": ["src/**/*.{js,jsx,ts,tsx,sass,scss}!", "scripts/**/*.{js,mjs}!"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "exports",
    "types",
    "duplicates",
    "cycles"
  ],
  "ignoreBinaries": ["rustc", "cc"],
  "ignoreDependencies": [
    "lint-staged",
    "@tauri-apps/plugin-http",
    "foxts",
    "nanoid"
  ],
  "ignore": [
    "src/pages/home.tsx",
    "src/components/home/**",
    "src/components/profile/log-viewer.tsx",
    "src/components/profile/profile-more.tsx",
    "src/components/test/**",
    "src/hooks/use-service-installer.ts",
    "src/services/api.ts"
  ],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"],
    "src/components/shared/traffic-error-boundary.tsx": ["exports"],
    "src/hooks/use-clash.ts": ["exports"],
    "src/hooks/use-connection-data.ts": ["exports"],
    "src/hooks/use-group-delays.ts": ["exports"],
    "src/hooks/use-system-state.ts": ["exports"],
    "src/hooks/use-traffic-monitor.ts": ["exports"],
    "src/hooks/use-update.ts": ["exports"],
    "src/providers/app-data-context.ts": ["exports"],
    "src/services/cmds.ts": ["exports"],
    "src/types/proxy-view.ts": ["exports"],
    "src/utils/traffic-sampler.ts": ["exports"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
